root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,html,scss,css,xml,csproj,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true

# "Handler" suffixes are the convention for command, query and domain event handlers.
dotnet_diagnostic.CA1711.severity = none

[src/Chat.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
