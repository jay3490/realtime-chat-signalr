<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core / EF Core stay on the 8.0 LTS servicing line to match net8.0 -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.33" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.33" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.33" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.33" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.33" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.33" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
    <!-- Test tooling -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
